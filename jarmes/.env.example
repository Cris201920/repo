# Copie este arquivo para ".env" (na pasta do projeto ou em %APPDATA%\JARMES) e preencha.
# O arquivo .env é ignorado pelo Git. NUNCA compartilhe suas chaves.

# --- Inteligência artificial (opcional; sem isto os recursos locais continuam funcionando) ---
# Provedores: anthropic | openai (OpenAI ou qualquer API compatível, como Ollama/OpenRouter) | none
JARMES_AI_PROVIDER=none
JARMES_AI_API_KEY=
# vazio = modelo padrão do provedor
JARMES_AI_MODEL=

# --- Google Drive (OAuth 2.0 — veja docs/INTEGRACOES.md) ---
JARMES_GOOGLE_CLIENT_ID=
JARMES_GOOGLE_CLIENT_SECRET=

# --- Voz remota (opcional): chave do serviço de transcrição; vazio = reutiliza JARMES_AI_API_KEY ---
JARMES_STT_API_KEY=

# --- Avançado ---
# Pasta de dados (padrão: %APPDATA%\JARMES no Windows)
# JARMES_DATA_DIR=
# Tamanho máximo de arquivo importado, em MB
JARMES_MAX_FILE_MB=100
