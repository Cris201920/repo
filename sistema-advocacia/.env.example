# Copie para .env e preencha (ou defina as variáveis no servidor de hospedagem)

# Chave da API da Anthropic (Claude) - necessária para o Assistente Jurídico
ANTHROPIC_API_KEY=
# Modelo usado pelo assistente
ANTHROPIC_MODEL=claude-sonnet-5-5
# (Opcional) modelo usado só para organizar documentos; um modelo menor reduz o custo.
# Se vazio, usa o mesmo de ANTHROPIC_MODEL.
ANTHROPIC_MODEL_ORGANIZAR=

# Porta do servidor
PORT=3000

# Pasta onde ficam o banco de dados e os arquivos (use um disco persistente e com backup)
DATA_DIR=./data

# Chave para criptografar os documentos em disco (AES-256-GCM). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se vazio, uma chave é criada em DATA_DIR/.chave (guarde uma cópia SEPARADA dos dados!)
DATA_KEY=

# Defina como 1 quando o site estiver atrás de HTTPS (cookies "Secure")
COOKIE_SECURE=0
# Defina como 1 se estiver atrás de proxy reverso (nginx, Caddy, Render, Railway...)
TRUST_PROXY=0
