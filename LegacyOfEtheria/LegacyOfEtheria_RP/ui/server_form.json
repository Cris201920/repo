      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(not ((#title_text - '§e§t§h') = #title_text))",
       "target_property_name": "#visible"
      }
     ]
    }
   }
  ]
 },
