{
 "format_version": "1.10.0",
 "minecraft:attachable": {
  "description": {
   "identifier": "etheria:dragon_chest",
   "materials": {
    "default": "armor",
    "enchanted": "armor_enchanted"
   },
   "textures": {
    "default": "textures/models/armor/etheria_dragon_1",
    "enchanted": "textures/misc/enchanted_item_glint"
   },
   "geometry": {
    "default": "geometry.humanoid.armor.chestplate"
   },
   "scripts": {
    "parent_setup": "variable.chest_layer_visible = 0.0;"
   },
   "render_controllers": [
    {
     "controller.render.armor": "!(c.owning_entity->q.property('etheria:lform') == 'true' || c.owning_entity->q.property('etheria:lform') == 'draconic' || c.owning_entity->q.property('etheria:slime') || c.owning_entity->q.property('etheria:mimic') > 0)"
    }
   ]
  }
 }
}