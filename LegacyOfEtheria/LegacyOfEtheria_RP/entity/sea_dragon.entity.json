{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "etheria:sea_dragon",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "default": "textures/entity/etheria_sea_dragon"
   },
   "geometry": {
    "default": "geometry.etheria_sea_dragon"
   },
   "spawn_egg": {
    "base_color": "#245a6a",
    "overlay_color": "#8ef0c8"
   },
   "scripts": {
    "scale": "1.0",
    "animate": [
     {
      "swim": "query.is_alive"
     },
     {
      "bite": "variable.attack_time > 0 && query.is_alive"
     },
     {
      "hurt": "query.hurt_time > 0 && query.is_alive"
     },
     {
      "flop": "!query.is_in_water && query.is_alive"
     },
     {
      "death": "!query.is_alive"
     }
    ]
   },
   "animations": {
    "swim": "animation.etheria.sea_dragon.swim",
    "bite": "animation.etheria.sea_dragon.bite",
    "hurt": "animation.etheria.sea_dragon.hurt",
    "death": "animation.etheria.sea_dragon.death",
    "flop": "animation.etheria.sea_dragon.flop"
   },
   "render_controllers": [
    "controller.render.default"
   ]
  }
 }
}