{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "etheria:mago_dourado",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "default": "textures/entity/etheria_mago_dourado"
   },
   "geometry": {
    "default": "geometry.etheria_mago_dourado_skin"
   },
   "spawn_egg": {
    "base_color": "#181820",
    "overlay_color": "#f0c030"
   },
   "animations": {
    "base_pose": "animation.humanoid.base_pose",
    "move": "animation.humanoid.move",
    "look_at_target": "controller.animation.humanoid.look_at_target",
    "attack": "animation.humanoid.attack.rotations",
    "life_idle": "animation.etheria.life.idle",
    "life_swing": "animation.etheria.life.swing",
    "life_hurt": "animation.etheria.life.hurt",
    "life_stance": "animation.etheria.life.stance"
   },
   "scripts": {
    "pre_animation": [
     "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed) * 57.3;"
    ],
    "animate": [
     "base_pose",
     "look_at_target",
     {
      "move": "query.modified_move_speed > 0.01"
     },
     {
      "attack": "variable.attack_time >= 0.0"
     },
     {
      "life_idle": "!query.is_moving && variable.attack_time <= 0"
     },
     {
      "life_swing": "variable.attack_time > 0.0"
     },
     {
      "life_hurt": "query.hurt_time > 0"
     },
     {
      "life_stance": "query.has_target && !query.is_moving && variable.attack_time <= 0"
     }
    ],
    "initialize": [
     "v.ph = math.random(0, 360); v.sp = math.random(0.85, 1.2);"
    ]
   },
   "render_controllers": [
    "controller.render.default"
   ]
  }
 }
}