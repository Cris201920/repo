{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "etheria:carrion",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "default": "textures/entity/etheria_carrion"
   },
   "geometry": {
    "default": "geometry.etheria_carrion"
   },
   "spawn_egg": {
    "base_color": "#8a5a2a",
    "overlay_color": "#ffd35c"
   },
   "scripts": {
    "animate": [
     {
      "idle": "!(query.ground_speed > 0.1)"
     },
     {
      "walk": "query.ground_speed > 0.1 && query.ground_speed <= 0.25 && !query.is_sneaking"
     },
     {
      "run": "query.ground_speed > 0.25"
     },
     {
      "halberd_swing": "variable.attack_time > 0"
     }
    ]
   },
   "animations": {
    "idle": "animation.etheria_carrion.idle",
    "idle_fly": "animation.etheria_carrion.idle_fly",
    "walk": "animation.etheria_carrion.walk",
    "run": "animation.etheria_carrion.run",
    "fly_slow": "animation.etheria_carrion.fly_slow",
    "fly_fast": "animation.etheria_carrion.fly_fast",
    "halberd_poke": "animation.etheria_carrion.halberd_poke",
    "halberd_swing": "animation.etheria_carrion.halberd_swing",
    "elephant_stampede": "animation.etheria_carrion.elephant_stampede",
    "lion_punch": "animation.etheria_carrion.lion_punch",
    "tiger_talon": "animation.etheria_carrion.tiger_talon",
    "beast_roar": "animation.etheria_carrion.beast_roar"
   },
   "render_controllers": [
    "controller.render.default"
   ]
  }
 }
}