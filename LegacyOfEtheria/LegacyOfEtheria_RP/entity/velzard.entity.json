{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "etheria:velzard",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "dragon": "textures/entity/etheria_pdrg_velzard",
    "human": "textures/entity/etheria_velzard_human"
   },
   "geometry": {
    "dragon": "geometry.etheria_pdrg_velzard_boss",
    "human": "geometry.etheria_velzard_human"
   },
   "spawn_egg": {
    "base_color": "#dff2ff",
    "overlay_color": "#7fd6ff"
   },
   "scripts": {
    "scale": "query.property('etheria:form') == 'dragon' ? 0.75 : 1.05",
    "animate": [
     {
      "idle": "query.property('etheria:form') == 'dragon'"
     },
     {
      "serpent": "query.property('etheria:form') == 'dragon'"
     },
     {
      "fly": "query.property('etheria:form') == 'dragon' && !query.is_on_ground && !query.is_in_water && query.is_alive"
     },
     {
      "attack": "query.property('etheria:form') == 'dragon' && variable.attack_time > 0"
     },
     {
      "ctl_dragon": "query.property('etheria:form') == 'dragon'"
     },
     {
      "h_look": "query.property('etheria:form') == 'human'"
     },
     {
      "h_walk": "query.property('etheria:form') == 'human'"
     },
     {
      "h_breathe": "query.property('etheria:form') == 'human'"
     },
     {
      "h_attack": "query.property('etheria:form') == 'human' && variable.attack_time >= 0"
     },
     {
      "ctl_human": "query.property('etheria:form') == 'human'"
     }
    ]
   },
   "animations": {
    "idle": "animation.etheria_pdrg_velzard.idle",
    "fly": "animation.etheria_pdrg.fly",
    "attack": "animation.etheria_serp_velzard.player_attack",
    "bite": "animation.etheria_serp_velzard.bite",
    "claw": "animation.etheria_serp_velzard.claw",
    "tail": "animation.etheria_serp_velzard.tail",
    "roar": "animation.etheria_serp_velzard.roar",
    "ability": "animation.etheria_serp_velzard.ability",
    "takeoff": "animation.etheria_serp_velzard.takeoff",
    "landing": "animation.etheria_serp_velzard.landing",
    "hurt": "animation.etheria_serp_velzard.hurt",
    "death": "animation.etheria_serp_velzard.death",
    "h_cast": "animation.etheria_tdr.h_cast",
    "h_transform": "animation.etheria_tdr.h_transform",
    "h_hurt": "animation.etheria_tdr.h_hurt",
    "h_death": "animation.etheria_tdr.h_death",
    "h_look": "animation.etheria.look",
    "h_walk": "animation.etheria.biped_walk",
    "h_attack": "animation.etheria.attack_biped",
    "h_breathe": "animation.etheria.breathe",
    "ctl_dragon": "controller.animation.etheria_tdr.dragon",
    "ctl_human": "controller.animation.etheria_tdr.human",
    "serpent": "animation.etheria_pdrg_velzard.serpent"
   },
   "render_controllers": [
    "controller.render.etheria_tdr"
   ],
   "particle_effects": {
    "shock": "etheria:fx_is_shockwave",
    "ring": "etheria:fx_is_ring_smoke",
    "spark": "etheria:fx_is_spark",
    "fog": "etheria:fx_is_fog",
    "dust": "etheria:earth_chunk",
    "elem": "etheria:fx_is_snowflake"
   }
  }
 }
}