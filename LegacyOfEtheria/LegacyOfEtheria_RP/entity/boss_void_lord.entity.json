{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "etheria:boss_void_lord",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "p1": "textures/entity/etheria_boss_void_lord_p1",
    "p2": "textures/entity/etheria_boss_void_lord_p2",
    "p3": "textures/entity/etheria_boss_void_lord_p3"
   },
   "geometry": {
    "default": "geometry.etheria_boss_void_lord"
   },
   "spawn_egg": {
    "base_color": "#4b1f8a",
    "overlay_color": "#d9a8ff"
   },
   "scripts": {
    "scale": "2.2",
    "animate": [
     "look",
     "walk",
     "attack",
     "breathe",
     "float",
     {
      "life_idle": "!query.is_moving && variable.attack_time <= 0"
     },
     {
      "life_swing": "variable.attack_time > 0.0"
     },
     {
      "life_hurt": "query.hurt_time > 0"
     },
     {
      "life_stance": "query.has_target && !query.is_moving && variable.attack_time <= 0"
     }
    ],
    "initialize": [
     "v.ph = math.random(0, 360); v.sp = math.random(0.85, 1.2);"
    ]
   },
   "animations": {
    "look": "animation.etheria.look",
    "breathe": "animation.etheria.breathe",
    "walk": "animation.etheria.biped_walk",
    "attack": "animation.etheria.attack_biped",
    "float": "animation.etheria.float",
    "life_idle": "animation.etheria.life.idle",
    "life_swing": "animation.etheria.life.swing",
    "life_hurt": "animation.etheria.life.hurt",
    "life_stance": "animation.etheria.life.stance"
   },
   "render_controllers": [
    "controller.render.etheria_boss"
   ]
  }
 }
}