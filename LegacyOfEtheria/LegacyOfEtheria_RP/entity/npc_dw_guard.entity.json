{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "etheria:npc_dw_guard",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "default": "textures/entity/etheria_npc_dw_guard"
   },
   "geometry": {
    "default": "geometry.etheria_npc_dw_guard"
   },
   "spawn_egg": {
    "base_color": "#55525e",
    "overlay_color": "#98a4c2"
   },
   "scripts": {
    "scale": "0.88",
    "animate": [
     "look",
     "walk",
     "attack",
     "breathe",
     {
      "life_idle": "!query.is_moving && variable.attack_time <= 0"
     },
     {
      "life_swing": "variable.attack_time > 0.0"
     },
     {
      "life_hurt": "query.hurt_time > 0"
     },
     "life_greet"
    ],
    "initialize": [
     "v.ph = math.random(0, 360); v.sp = math.random(0.85, 1.2);"
    ]
   },
   "animations": {
    "look": "animation.etheria.look",
    "breathe": "animation.etheria.breathe",
    "walk": "animation.etheria.biped_walk",
    "attack": "animation.etheria.attack_biped",
    "life_idle": "animation.etheria.life.idle",
    "life_swing": "animation.etheria.life.swing",
    "life_hurt": "animation.etheria.life.hurt",
    "life_talk": "animation.etheria.life.talk",
    "life_wave": "animation.etheria.life.wave",
    "life_greet": "controller.animation.etheria.life.greet"
   },
   "render_controllers": [
    "controller.render.default"
   ]
  }
 }
}