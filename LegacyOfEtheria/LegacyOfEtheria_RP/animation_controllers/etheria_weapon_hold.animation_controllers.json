{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.etheria.weapon_hold": {
   "initial_state": "first_person",
   "states": {
    "first_person": {
     "animations": [
      "hold_fp"
     ],
     "transitions": [
      {
       "third_person": "!c.is_first_person"
      }
     ]
    },
    "third_person": {
     "animations": [
      "hold_tp"
     ],
     "transitions": [
      {
       "first_person": "c.is_first_person"
      }
     ]
    }
   }
  }
 }
}