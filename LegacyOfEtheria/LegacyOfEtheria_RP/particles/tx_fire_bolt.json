{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "etheria:tx_fire_bolt",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/tensura/fire_bolt"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "variable.dx",
     "variable.dy",
     "variable.dz"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life"
   },
   "minecraft:particle_initial_speed": "variable.spd",
   "minecraft:particle_initial_spin": {
    "rotation": "math.random(0, 360) * (1 - variable.flat)",
    "rotation_rate": "0"
   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     "variable.ax",
     "variable.ay",
     "variable.az"
    ],
    "linear_drag_coefficient": "variable.drag"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size*(1+variable.grow*v.particle_age/v.particle_lifetime)",
     "variable.size*(1+variable.grow*v.particle_age/v.particle_lifetime)"
    ],
    "facing_camera_mode": "rotate_xyz",
    "uv": {
     "texture_width": 48,
     "texture_height": 264,
     "flipbook": {
      "base_UV": [
       0,
       0
      ],
      "size_UV": [
       48,
       44
      ],
      "step_UV": [
       0,
       44
      ],
      "frames_per_second": 12,
      "max_frame": 6,
      "stretch_to_lifetime": true,
      "loop": false
     }
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.r",
     "variable.g",
     "variable.b",
     "variable.a * math.min(1, v.particle_age * 12) * (1 - math.pow(v.particle_age / v.particle_lifetime, 3))"
    ]
   }
  }
 }
}