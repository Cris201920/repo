{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "etheria:streak",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/etheria_atlas"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 1
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     0,
     0,
     0
    ],
    "direction": [
     "variable.dx",
     "variable.dy",
     "variable.dz"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.sx",
     "variable.sy"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "custom",
     "custom_direction": [
      "variable.dx",
      "variable.dy",
      "variable.dz"
     ]
    },
    "uv": {
     "texture_width": 128,
     "texture_height": 128,
     "uv": [
      "variable.tu*16",
      "variable.tv*16"
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.r",
     "variable.g",
     "variable.b",
     "variable.a * math.min(1, v.particle_age * 8) * (1 - math.pow(v.particle_age / v.particle_lifetime, 2))"
    ]
   }
  }
 }
}