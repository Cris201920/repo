{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "etheria:wingline",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/etheria_wingfx"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     0,
     0,
     0
    ],
    "direction": [
     "variable.dx",
     "variable.dy",
     "variable.dz"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.sx * (1 - 0.35 * v.particle_age / v.particle_lifetime)",
     "variable.sy"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "custom",
     "custom_direction": [
      "variable.dx",
      "variable.dy",
      "variable.dz"
     ]
    },
    "uv": {
     "texture_width": 64,
     "texture_height": 64,
     "uv": [
      "variable.tu*16",
      0
     ],
     "uv_size": [
      16,
      64
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.r",
     "variable.g",
     "variable.b",
     "variable.a * math.min(1, v.particle_age * 14) * (1 - math.pow(v.particle_age / v.particle_lifetime, 3))"
    ]
   }
  }
 }
}