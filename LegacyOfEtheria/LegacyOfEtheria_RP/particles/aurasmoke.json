     "math.sin((v.particle_random_1*360+v.swl*v.particle_age*((v.particle_random_4>1-v.ring)?2:1)))*((v.particle_random_4<v.vein)?v.rad*(0.45+0.55*v.particle_random_2):((v.particle_random_4>1-v.ring)?v.rr*(1+0.12*v.particle_age):v.rad*(0.3+0.7*v.particle_random_2)*(1+0.45*v.particle_age)))+v.dvz*v.particle_age"
    ]
   },
   "minecraft:particle_appearance_billboard": {
