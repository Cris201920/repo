     "((v.particle_random_4<v.vein)?v.vr:((v.particle_random_4>1-v.ring)?v.gr:v.cr+(v.vr-v.cr)*math.pow(v.particle_random_2,12)*0.6))",
     "((v.particle_random_4<v.vein)?v.vg:((v.particle_random_4>1-v.ring)?v.gg:v.cg+(v.vg-v.cg)*math.pow(v.particle_random_2,12)*0.6))",
