     "((v.particle_random_4<v.vein)?v.vw*(0.7+0.6*v.particle_random_2):((v.particle_random_4>1-v.ring)?v.rs*(0.7+0.6*v.particle_random_2):(v.sz*(0.6+0.8*v.particle_random_3)*(0.55+v.grow*(v.particle_age/v.particle_lifetime)))))",
     "((v.particle_random_4<v.vein)?v.vh*(0.7+0.6*v.particle_random_2):((v.particle_random_4>1-v.ring)?v.rs*(0.7+0.6*v.particle_random_2):(v.sz*(0.6+0.8*v.particle_random_3)*(0.55+v.grow*(v.particle_age/v.particle_lifetime)))))"
