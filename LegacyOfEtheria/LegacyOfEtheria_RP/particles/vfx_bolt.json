{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "etheria:vfx_bolt",
   "basic_render_parameters": {
    "material": "particles_blend",
    "texture": "textures/particle/etheria_vfx"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "variable.dx",
     "variable.dy",
     "variable.dz"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life"
   },
   "minecraft:particle_initial_speed": "variable.spd",
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     "variable.ax",
     "variable.ay",
     "variable.az"
    ],
    "linear_drag_coefficient": "variable.drag"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.sx",
     "variable.sy"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "custom",
     "custom_direction": [
      "variable.dx",
      "variable.dy",
      "variable.dz"
     ]
    },
    "uv": {
     "texture_width": 256,
     "texture_height": 128,
     "uv": [
      "(math.mod(math.floor(v.particle_age * 20 + variable.seed), 4))*32",
      "(0)*32"
     ],
     "uv_size": [
      32,
      32
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.r",
     "variable.g",
     "variable.b",
     "variable.a * math.min(1, v.particle_age * 12) * (1 - math.pow(v.particle_age / v.particle_lifetime, 2))"
    ]
   }
  }
 }
}