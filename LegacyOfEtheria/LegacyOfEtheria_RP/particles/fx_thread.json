   },
   "minecraft:particle_motion_dynamic": {
    "linear_acceleration": [
     0,
     0.1,
     0
    ],
    "linear_drag_coefficient": 0.8,
    "rotation_drag_coefficient": 0
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "(0.24 + 0.28 * variable.particle_random_1) * (1 + 0.25 * Math.sin(variable.particle_age * 504)) * Math.min(1, (variable.particle_lifetime - variable.particle_age) * 4) * (variable.ft_s > 0 ? variable.ft_s : 1)",
     "(0.24 + 0.28 * variable.particle_random_1) * (1 + 0.25 * Math.sin(variable.particle_age * 504)) * Math.min(1, (variable.particle_lifetime - variable.particle_age) * 4) * (variable.ft_s > 0 ? variable.ft_s : 1)"
    ],
    "facing_camera_mode": "lookat_xyz",
    "uv": {
