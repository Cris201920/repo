       0
      ],
      "size_UV": [
       16,
       16
      ],
      "step_UV": [
       0,
       16
      ],
      "frames_per_second": 9,
      "max_frame": 5,
      "stretch_to_lifetime": false,
      "loop": true
     }
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "(variable.ft_on > 0 ? variable.ft_r : 1)",
     "(variable.ft_on > 0 ? variable.ft_g : 1)",
     "(variable.ft_on > 0 ? variable.ft_b : 1)",
     "Math.min(1, variable.particle_age / 0.15) * Math.min(1, (variable.particle_lifetime - variable.particle_age) / 0.6)"
    ]
   }
