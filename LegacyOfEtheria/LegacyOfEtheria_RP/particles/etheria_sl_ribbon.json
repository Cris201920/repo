{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "etheria:sl_ribbon",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/etheria_slash"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_point": {
    "direction": [
     "variable.dx",
     "variable.dy",
     "variable.dz"
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.sx * (1 - 0.6 * (v.particle_age / v.particle_lifetime))",
     "variable.sy"
    ],
    "facing_camera_mode": "lookat_direction",
    "direction": {
     "mode": "custom",
     "custom_direction": [
      "variable.dx",
      "variable.dy",
      "variable.dz"
     ]
    },
    "uv": {
     "texture_width": 256,
     "texture_height": 128,
     "uv": [
      "math.mod(variable.tile, 4) * 64",
      "math.floor((variable.tile) / 4) * 64"
     ],
     "uv_size": [
      64,
      64
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.r",
     "variable.g",
     "variable.b",
     "variable.a * math.min(1, v.particle_age * 25) * (1 - math.pow((v.particle_age / v.particle_lifetime), 1.6))"
    ]
   }
  }
 }
}