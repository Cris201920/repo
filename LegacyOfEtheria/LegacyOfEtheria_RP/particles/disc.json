{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "etheria:disc",
   "basic_render_parameters": {
    "material": "particles_alpha",
    "texture": "textures/particle/etheria_circles"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": 1
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 1
   },
   "minecraft:emitter_shape_point": {
    "offset": [
     0,
     0,
     0
    ],
    "direction": [
     0,
     0,
     0
    ]
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life"
   },
   "minecraft:particle_motion_parametric": {
    "relative_position": [
     0,
     0,
     0
    ],
    "rotation": "variable.rot*v.particle_age"
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size*(1+variable.grow*v.particle_age/v.particle_lifetime)",
     "variable.size*(1+variable.grow*v.particle_age/v.particle_lifetime)"
    ],
    "facing_camera_mode": "emitter_transform_xz",
    "uv": {
     "texture_width": 256,
     "texture_height": 256,
     "uv": [
      "variable.tu*64",
      "variable.tv*64"
     ],
     "uv_size": [
      64,
      64
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.r",
     "variable.g",
     "variable.b",
     "variable.a * math.min(1, v.particle_age * 5) * math.min(1, (v.particle_lifetime - v.particle_age) * 3)"
    ]
   }
  }
 }
}